# --- Supabase (auth, database, storage) ---
# Leave these unset to run the app in demo mode: the full upload → consultation
# → generate → results flow still works, but nothing persists and accounts
# are disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Image generation provider ---
# "mock" (default) echoes the uploaded reference back as the "result" so the
# full product flow can be exercised without a paid model. Switch to a real
# provider once one is wired up in lib/image-generation/providers/.
IMAGE_GENERATION_PROVIDER=mock

# Example config for the Replicate provider stub (lib/image-generation/providers/replicate-provider.ts):
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=

# --- Stripe (optional, for paid credit packs / subscriptions) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
